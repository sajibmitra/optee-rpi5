diff --git a/core/arch/arm/kernel/boot.c b/core/arch/arm/kernel/boot.c
index bcb07a40e..05dcfa428 100644
--- a/core/arch/arm/kernel/boot.c
+++ b/core/arch/arm/kernel/boot.c
@@ -814,6 +814,11 @@ static int mark_tzdram_as_reserved(struct dt_descriptor *dt)
 				   CFG_TZDRAM_SIZE);
 }
 
+int __weak plat_dt_add_reserved_mem(struct dt_descriptor *dt __unused)
+{
+	return 0;
+}
+
 static void update_external_dt(void)
 {
 	struct dt_descriptor *dt = get_external_dt_desc();
@@ -834,6 +839,9 @@ static void update_external_dt(void)
 
 	if (mark_tzdram_as_reserved(dt))
 		panic("Failed to config secure memory");
+
+	if (plat_dt_add_reserved_mem(dt))
+		panic("Failed to add platform reserved memory");
 }
 #else /*CFG_DT*/
