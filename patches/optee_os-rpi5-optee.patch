diff --git a/core/arch/arm/plat-rpi5/conf.mk b/core/arch/arm/plat-rpi5/conf.mk
index 4bc963508..e4aa3891f 100644
--- a/core/arch/arm/plat-rpi5/conf.mk
+++ b/core/arch/arm/plat-rpi5/conf.mk
@@ -12,10 +12,15 @@ CFG_TZDRAM_START    ?= 0x1D000000
 CFG_TZDRAM_SIZE     ?= 0x02000000
 CFG_TEE_RAM_VA_SIZE ?= 0x00700000
 CFG_DT              ?= y
-CFG_DTB_MAX_SIZE    ?= 0x20000
+# Extra headroom for optee_core / optee_shm / optee_sw_log reserved-memory nodes
+CFG_DTB_MAX_SIZE    ?= 0x40000
 
 $(call force,CFG_PL011,y)
 $(call force,CFG_SECURE_TIME_SOURCE_CNTPCT,y)
 $(call force,CFG_WITH_ARM_TRUSTED_FW,y)
 
 CFG_NUM_THREADS ?= 4
+
+# Secure-world log ring in NS RAM for SSH monitoring (optee-sw-log).
+# Mapped as MEM_AREA_IO_NSEC so io_pa_or_va works after MMU is on.
+CFG_RPI5_SW_LOG ?= y
